{
  "name": "rudralipi",
  "version": "0.1.0-alpha.0",
  "private": true,
  "description": "A product-independent document composition and visual editing engine.",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "https://github.com/mpoonuru/rudralipi.git"
  },
  "bugs": {
    "url": "https://github.com/mpoonuru/rudralipi/issues"
  },
  "homepage": "https://github.com/mpoonuru/rudralipi#readme",
  "packageManager": "bun@1.3.14",
  "engines": {
    "bun": ">=1.3.14",
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/*",
    "examples/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "check:boundaries": "bun scripts/check-boundaries.mjs",
    "check:locales": "bun scripts/check-locales.mjs",
    "check:public-imports": "bun scripts/check-public-imports.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "bun test scripts/*.test.mjs && bun run --parallel --filter '*' --if-present test",
    "typecheck": "bun run --filter '*' typecheck",
    "verify": "bun run format:check && bun run lint && bun run check:boundaries && bun run typecheck && bun run test && bun run build",
    "verify:release": "bun ci && bun run verify && bun run check:public-imports && bun run check:locales"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.8.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.65.0",
    "vitest": "4.1.10"
  }
}
